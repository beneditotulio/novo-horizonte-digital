# Backend Environment Variables

# Database Connection (SQL Server LocalDB - Windows)
CONNECTION_STRING=Server=(localdb)\mssqllocaldb;Database=NovoHorizonteDigital;Trusted_Connection=true;

# JWT Configuration
JWT_SECRET_KEY=YourVerySecureSecretKeyWith32CharactersMinimumRequirementForHS256Algorithm
JWT_ISSUER=NovoHorizonteDigital
JWT_AUDIENCE=NovoHorizonteDigitalUsers
JWT_EXPIRATION_MINUTES=1440

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API Configuration
API_HTTPS_PORT=5001
API_HTTP_PORT=5000

# Email Configuration (Optional - for future use)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png
UPLOAD_PATH=/app/uploads

# Environment
ENVIRONMENT=Development
